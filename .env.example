# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=change-this-to-a-long-random-string

# Admin login (used by `flask --app run create-admin`)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-password

# Business contact info shown on the site (defaults already set in config.py to the real
# Dr Blinds Decor & Services LLC info; override here only if it changes)
BUSINESS_PHONE=
BUSINESS_PHONE_LINK=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_INSTAGRAM_HANDLE=
BUSINESS_INSTAGRAM_URL=

# Optional: SMTP email notifications (owner alert + customer confirmation).
# Leave blank to run without email - requests still appear in /admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OWNER_NOTIFY_EMAIL=
